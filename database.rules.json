{
  "rules": {
    "salas": {
      ".indexOn": ["actividad"],
      ".read": "auth != null && query.orderByChild === 'actividad' && query.limitToFirst <= 20",
      "$codigo": {
        ".read": true,
        ".write": "auth != null && !newData.exists() && (!data.child('actividad').exists() || data.child('actividad').val() < now - 86400000)",
        "host": {
          ".write": "auth != null && !data.exists() && newData.val() === auth.uid"
        },
        "creada": {
          ".write": "auth != null && !data.exists()",
          ".validate": "newData.val() === now"
        },
        "actividad": {
          ".write": "auth != null && (newData.parent().child('host').val() === auth.uid || root.child('salas').child($codigo).child('jugadores').child(auth.uid).exists())",
          ".validate": "newData.val() === now"
        },
        "jugadores": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (data.exists() || !root.child('salas').child($codigo).child('partida').exists())",
            ".validate": "!newData.exists() || (newData.hasChildren(['nombre', 'unido']) && newData.child('nombre').isString() && newData.child('nombre').val().length >= 1 && newData.child('nombre').val().length <= 16)"
          }
        },
        "partida": {
          ".write": "auth != null && (root.child('salas').child($codigo).child('host').val() === auth.uid || (data.exists() && data.child('fin').val() === false && data.child('actual').val() === auth.uid))",
          ".validate": "!newData.exists() || (newData.hasChildren(['estado', 'actual', 'fin', 'v']) && newData.child('estado').isString() && newData.child('estado').val().length <= 40000 && newData.child('actual').isString() && newData.child('fin').isBoolean() && newData.child('v').isNumber())"
        },
        "$otro": { ".validate": false }
      }
    }
  }
}
